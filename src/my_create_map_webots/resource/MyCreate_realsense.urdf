  <!-- ======================= REALSENSE CAMERA ======================= -->
  <!-- This is the physical body of the Realsense D455 camera -->
  <link name="Realsense">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.084 0.027 0.068"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.084 0.027 0.068"/>
      </geometry>
    </collision>
  </link>

  <!-- This joint mounts the camera body onto the robot's base link -->
  <joint name="base_to_realsense_joint" type="fixed">
    <parent link="base_link"/>
    <child link="Realsense"/>
    <!-- Position the camera 14cm forward and 10cm up from the base_link origin -->
    <origin xyz="0.14 0 0.05" rpy="0 0 0"/>
  </joint>

  <link name="camera_rgb_frame">
  </link>
  <joint name="realsense_to_camera_rgb_joint" type="fixed">
    <parent link="Realsense"/>
    <child link="camera_rgb_frame"/>
    <origin xyz="0.005 0 0" rpy="0 0 0"/>
  </joint>

  <!-- camera rgb optical frame -->
  <link name="camera_rgb_optical_frame">
  </link>
  <joint name="camera_rgb_to_camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <link name="camera_depth_frame">
  </link>
  <joint name="realsense_to_camera_depth_joint" type="fixed">
    <parent link="Realsense"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.005 0 0" rpy="0 0 0"/>
  </joint>

  <!-- camera rgb optical frame -->
  <link name="camera_depth_optical_frame">
  </link>
  <joint name="camera_depth_to_camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>
  <!-- End camera thingy -->


