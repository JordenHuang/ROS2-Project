  <webots>
    <plugin type="my_create_map_webots.my_create_driver_realsense.MyCreateDriverRealsense"/>
  </webots>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.027 0.123 0.025"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.027 0.123 0.025"/>
      </geometry>
    </collision>
  </link>


  <!-- IMU link -->
  <link name="imu_link">
  </link>
  <joint name="base_link_to_imu_link_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>


  <link name="solid">
  </link>
  <joint name="base_link_solid_joint" type="fixed">
    <parent link="base_link"/>
    <child link="solid"/>
    <origin xyz="0.013 0 0" rpy="1.570798 -0.000002 1.570801"/>
  </joint>

  <link name="RealsenseD455_display">
