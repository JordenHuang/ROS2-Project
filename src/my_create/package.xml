<?xml version="1.0"?>
<package format="3">
  <name>my_create</name>
  <version>0.0.1</version>
  <description>ROS2 package for MyCreate robot in Webots</description>
  <maintainer email="jorden90573@gmail.com">jordenhuang</maintainer>
  <license>Apache-2.0</license>

  <!-- 核心依賴 -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>rtabmap_rviz_plugins</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>

  <!-- 測試依賴 -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <!-- 告訴 colcon 這是個 python 套件 -->
    <build_type>ament_python</build_type>
  </export>
</package>
